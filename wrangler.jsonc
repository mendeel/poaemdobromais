{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poaemdobromais",
  "compatibility_date": "2026-11-04",
  "main": "./worker/index.js",
  // The Vite plugin points assets at the client build. Only /api/* reaches the
  // Worker; everything else is served straight from static assets.
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  // No database_id: the first `wrangler deploy` creates the database and
  // writes its id back here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poaemdobromais-ratings"
    }
  ],
  "routes": [{ "pattern": "poaemdobro.mendel.vip", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
